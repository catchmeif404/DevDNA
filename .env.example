# GitHub OAuth App (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Database (defaults match docker-compose; override for self-hosting)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devwrapped
DB_USER=devwrapped
DB_PASSWORD=devwrapped

# Frontend base URL, used for the OAuth login redirect
FRONTEND_URL=http://localhost:3010

# NOTE: MVP share cards are rendered on-demand as SVG (GET /api/share/{username}/card)
# straight from analysis_results, so no S3/R2 storage is needed yet. AI natural-language
# summaries are also out of MVP scope (section 3.2) — a rule-based template stands in for now.
